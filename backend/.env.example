# FILE: backend/.env.example
# Copy to backend/.env and fill in real values.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (development — no setup needed):
DATABASE_URL=sqlite:///./axon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://axon_user:password@localhost:5432/axon_db

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

# JWT expiry in seconds (default 1 hour)
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Invitation link TTL in seconds (default 7 days)
INVITE_TOKEN_TTL_SECONDS=604800

# Internal worker-to-API shared secret
WORKER_SECRET=dev-worker-secret

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 Storage ───────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=axon-uploads

# ── API ──────────────────────────────────────────────────────────────────────
# Used by the Celery worker to call back the internal result endpoint.
API_BASE_URL=http://localhost:8000/api/v1

# ── Dashboard cache ──────────────────────────────────────────────────────────
DASHBOARD_CACHE_TTL_SECONDS=900
