// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id         Int      @id @default(autoincrement())
  fullname   String
  email      String   @unique
  password   String
  phone      String?
  created_at DateTime @default(now())

  // Relations mapping for Prisma
  roles             Role[]
  authored_images   Image[]            @relation("UserAuthors")
  label_validations LabelValidation[]
}

model Role {
  user_id        Int
  competition_id Int
  role           String // Prisma sqlite doesn't support enums natively

  user        User        @relation(fields: [user_id], references: [id])
  competition Competition @relation(fields: [competition_id], references: [id])

  @@id([user_id, competition_id])
}

model Competition {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  launch_date     DateTime?
  configjson      String?   // JSON mappings
  invitation_link String?   @unique

  roles      Role[]
  config     Config?
  teams      Team[]
  phase_logs PhaseLog[]
  models     Model[]
}

model Config {
  id                   Int         @id @default(autoincrement())
  competition_id       Int         @unique
  labels               String?
  data_ex              String?
  scoring_ex           String?
  overview             String?
  terms_conditions     String?
  data_md              String?
  data_format          String?
  evaluation           String?
  duplicate_threshhold Float?

  competition Competition @relation(fields: [competition_id], references: [id])
}

model Team {
  id       Int    @id @default(autoincrement())
  name     String
  comp_id  Int
  user_ids String? // JSON field

  competition Competition @relation(fields: [comp_id], references: [id])
  images      Image[]
  datasets    Dataset[]
  models      Model[]

  @@unique([name, comp_id])
}

model PhaseLog {
  id             Int    @id @default(autoincrement())
  competition_id Int
  phase_dates    String?
  current_phase  String

  competition Competition @relation(fields: [competition_id], references: [id])
}

model Image {
  id                Int      @id @default(autoincrement())
  team_id           Int
  author_id         Int
  time              DateTime @default(now())
  label             String?
  filepath          String   @unique
  status            String   @default("onhold")
  original_filename String?
  old_extension     String?
  image_hash        String   @unique
  old_size_mb       Float?
  old_width         Float?
  old_height        Float?
  device            String?

  team     Team           @relation(fields: [team_id], references: [id])
  author   User           @relation("UserAuthors", fields: [author_id], references: [id])
  metadata ImageMetadata?
  labels   Label[]
}

model ImageMetadata {
  id                  Int       @id @default(autoincrement())
  image_id            Int       @unique
  GPSInfo             String?
  ImageWidth          Float?
  ImageLength         Float?
  ResolutionUnit      String?
  ExifOffset          Float?
  Make                String?
  Model               String?
  Software            String?
  Orientation         Float?
  DateTime            DateTime?
  YCbCrPositioning    String?
  XResolution         Float?
  YResolution         Float?
  New_width           Float?
  New_height          Float?
  New_size_mb         Float?
  Extra_subfolder     String?
  original_resolution String?
  new_resolution      String?
  resizing_method     String?
  format_change       String?
  label               String?
  english_name        String?
  scientific_name     String?

  image Image @relation(fields: [image_id], references: [id])
}

model Label {
  id        Int     @id @default(autoincrement())
  image_id  Int
  label     String
  validated Boolean @default(false)

  image       Image             @relation(fields: [image_id], references: [id])
  validations LabelValidation[]
}

model LabelValidation {
  id           Int      @id @default(autoincrement())
  label_id     Int
  validator_id Int
  label_val    String
  validated_at DateTime @default(now())

  label     Label @relation(fields: [label_id], references: [id])
  validator User  @relation(fields: [validator_id], references: [id])
}

model Dataset {
  id              Int     @id @default(autoincrement())
  team_id         Int
  team_folderpath String?

  team Team @relation(fields: [team_id], references: [id])
}

model Model {
  id                  Int      @id @default(autoincrement())
  team_id             Int
  competition_id      Int
  docker_img_filepath String
  submitted_at        DateTime @default(now())

  team        Team         @relation(fields: [team_id], references: [id])
  competition Competition  @relation(fields: [competition_id], references: [id])
  evaluations Evaluation[]
}

model Evaluation {
  id           Int      @id @default(autoincrement())
  model_id     Int
  score        Float
  evaluated_at DateTime @default(now())

  model Model @relation(fields: [model_id], references: [id])
}


