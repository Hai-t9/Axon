# ============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================
# Note: This is development-only. Production will use MinIO + Redis on hardware.

# ============================================
# SUPABASE REMOTE DATABASE (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://postgres.nacfcrwbqzozypmxbeap:IR04lXIm6CWFlSeX@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ============================================
# MINIO OBJECT STORAGE - DEVELOPMENT FALLBACK
# ============================================
# During development: Files are stored locally in ./uploads
# The code will use local storage as a fallback if these variables are not set
# 
# PRODUCTION: Uncomment these when you have hardware access and MinIO running
# MINIO_ENDPOINT="http://your-school-server:9000"
# MINIO_ACCESS_KEY="your-access-key"
# MINIO_SECRET_KEY="your-secret-key"
# MINIO_BUCKET_NAME="axon-uploads"

# For now, leave these disabled - local fallback will be used automatically
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET_NAME=""

# ============================================
# REDIS CACHE - DEVELOPMENT OPTIONAL
# ============================================
# During development: Caching is optional
# The code will work without Redis (graceful degradation)
# 
# PRODUCTION: Uncomment when you have Redis running on hardware
# REDIS_URL="redis://your-school-server:6379/0"

REDIS_URL=""
DASHBOARD_CACHE_TTL_SECONDS=900

# ============================================
# APPLICATION SETTINGS
# ============================================
DEBUG=True
SECRET_KEY="dev-secret-key-change-in-production"
API_VERSION="v1"

# ============================================
# LOCAL STORAGE PATHS (DEVELOPMENT FALLBACK)
# ============================================
# These directories are used when MinIO is unavailable
UPLOAD_DIR="./uploads"
MODEL_DIR="./models"
